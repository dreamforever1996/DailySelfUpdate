# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
#
# {$SITE_ADDRESS} = space-separated site addresses. List the SAME domain on both
# 443 (implicit) and the high port, so HTTPS works on either. Example:
#   SITE_ADDRESS="dailyselfupdate.online www.dailyselfupdate.online dailyselfupdate.online:8443 www.dailyselfupdate.online:8443"
#
# Why two ports: during ICP 备案 the ISP may block 80/443 → use https://<domain>:8443
# meanwhile. Once 备案 passes, https://<domain> (443) just works. The cert is
# obtained once (via port 80 ACME) and reused on the high port too.
#
# Path routing:
#   /api/*          → DailySelfUpdate backend (backend:3001)
#   /aiinfra/api/*  → AIInfra backend (aiinfra-backend:8000)
#   /aiinfra*       → AIInfra frontend (aiinfra-frontend:3000)
#   /*              → DailySelfUpdate frontend (frontend:3000)

{$SITE_ADDRESS} {
	encode gzip

	# DailySelfUpdate API
	handle /api/* {
		reverse_proxy backend:3001
	}

	# AIInfra Learning Platform API  — strip /aiinfra prefix before proxying
	handle /aiinfra/api/* {
		uri strip_prefix /aiinfra
		reverse_proxy aiinfra-backend:8000
	}

	# AIInfra Learning Platform frontend
	handle /aiinfra* {
		reverse_proxy aiinfra-frontend:3000
	}

	# DailySelfUpdate frontend (catch-all)
	handle {
		reverse_proxy frontend:3000
	}
}
